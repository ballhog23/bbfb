---
import NavLink from "@components/NavLink.astro";
import GridIcon from "@assets/icons/grid.svg";
import { LEAGUE_INFO_NAV, type PageKey } from "@data/site";

type Props = {
    active?: PageKey | undefined;
};

const { active } = Astro.props;
const inGroup = LEAGUE_INFO_NAV.some((link) => link.key === active);
---

<div class="league-info">
    <button
        class="toggle"
        class:list={{ current: inGroup }}
        type="button"
        aria-expanded="false"
        aria-controls="league-info-menu"
    >
        <span>League Info</span>
        <GridIcon aria-hidden="true" width={16} height={16} />
    </button>
    <ul id="league-info-menu" hidden>
        {LEAGUE_INFO_NAV.map((link) => (
            <li>
                <NavLink link={link} active={link.key === active} />
            </li>
        ))}
    </ul>
</div>

<style>
    .league-info {
        position: relative;
    }

    .toggle {
        display: flex;
        align-items: center;
        gap: 0.3125rem;
        margin: 0;
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        font-weight: 500;
        line-height: 1;
        letter-spacing: var(--ls-1);
        text-transform: uppercase;
        color: var(--text-soft);
        cursor: pointer;
        transition: color 0.3s ease;

        &:hover,
        &[aria-expanded="true"] {
            color: var(--link-hover);
        }

        &.current {
            color: var(--blue-500);
        }
    }

    ul {
        position: absolute;
        top: calc(100% + 1.75rem);
        right: 0;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        min-width: 14rem;
        padding: 1.5rem;
        background: var(--bg);
        border: 1px solid var(--border);
    }
</style>

<script>
    const root = document.querySelector<HTMLElement>(".league-info");
    const toggle = root?.querySelector<HTMLButtonElement>("button");
    const menu = root?.querySelector<HTMLUListElement>("ul");

    if (root && toggle && menu) {
        const setOpen = (open: boolean) => {
            menu.hidden = !open;
            toggle.setAttribute("aria-expanded", String(open));
        };

        toggle.addEventListener("click", () =>
            setOpen(toggle.getAttribute("aria-expanded") !== "true")
        );

        document.addEventListener("click", (event) => {
            if (!root.contains(event.target as Node)) setOpen(false);
        });

        root.addEventListener("keydown", (event) => {
            if (event.key !== "Escape" || menu.hidden) return;
            setOpen(false);
            toggle.focus();
        });
    }
</script>
