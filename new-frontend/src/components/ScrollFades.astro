<script>
    // Each element fades on its own position on the screen.
    // data-fade-in="left|right": slide in from that side as it comes up from the bottom.
    // data-fade-out: fade up and out as it goes past 30% from the top.
    // data-stagger="0..3": start the fade-in a little later.
    // data-out-start="0.05": move the fade-out line, as a part of the screen height.
    const elements = document.querySelectorAll<HTMLElement>(
        "[data-fade-in], [data-fade-out]"
    );
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;

    // The lift this script added to each element, so the element's own
    // movement does not change its timing.
    const lifts = new WeakMap<HTMLElement, number>();
    const clamp = (value: number) => Math.min(1, Math.max(0, value));

    function update() {
        const vh = window.innerHeight;
        const inDistance = vh * 0.3;
        const outDistance = vh * 0.4;
        const delayStep = vh * 0.04;

        for (const el of elements) {
            const { fadeIn, stagger, outStart } = el.dataset;
            const top = el.getBoundingClientRect().top - (lifts.get(el) ?? 0);
            const side = fadeIn === "left" ? -1 : fadeIn === "right" ? 1 : 0;
            const delay = Number(stagger ?? 0) * delayStep;

            const inProgress = side
                ? clamp((vh - top - delay) / inDistance)
                : 1;
            const outLine = vh * Number(outStart ?? 0.3);
            const outProgress =
                el.dataset.fadeOut === undefined
                    ? 0
                    : clamp((outLine - top) / outDistance);

            const x = side * 2 * (1 - inProgress);
            const y = -12 * outProgress;
            el.style.opacity = (inProgress * (1 - outProgress)).toFixed(3);
            el.style.transform = `translate(${x.toFixed(3)}rem, ${y.toFixed(2)}vh)`;
            lifts.set(el, -0.12 * vh * outProgress);
        }
    }

    if (!reduceMotion && elements.length) {
        let frame = 0;
        const schedule = () => {
            if (frame) return;
            frame = requestAnimationFrame(() => {
                frame = 0;
                update();
            });
        };
        document.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", schedule, { passive: true });
        update();
    }
</script>
