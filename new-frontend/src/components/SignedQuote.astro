---
import { fade, type FadeOptions } from "@lib/fade";

type Props = {
    signature: string;
    fade?: FadeOptions;
};

const { signature, fade: fadeOptions } = Astro.props;
---

<blockquote {...fade(fadeOptions)}>
    <p>
        <slot />
    </p>
    <footer>{signature}</footer>
</blockquote>

<style>
    blockquote {
        max-width: 40ch;
        padding-left: 1.25rem;
        border-left: 3px solid var(--blue-500);
    }

    p {
        font-size: var(--fs-lg);
        font-style: italic;
        line-height: 1.5;
        color: var(--text-soft);
    }

    footer {
        margin-top: 1rem;
        font-weight: 600;
        color: var(--blue-300);
    }
</style>
