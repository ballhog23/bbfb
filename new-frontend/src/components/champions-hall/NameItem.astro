---
import { fade } from "@lib/fade";

type Props = {
    /** Place in the list, from 0. Later items fade in a little later. */
    index: number;
};

const { index } = Astro.props;
---

<li {...fade({ in: "left", stagger: Math.min(index + 1, 3) })}>
    <slot />
</li>

<style>
    li {
        max-width: 60ch;
        font-size: var(--fs-lead);
        color: var(--text-soft);
    }
</style>
