---
import { externalText } from "@lib/external-link";

type Props = {
    href: string;
    class?: string;
};

const { href, class: className } = Astro.props;
const text = await Astro.slots.render("default");
---

<a
    class={className}
    href={href}
    target="_blank"
    rel="noopener"
    set:html={externalText(text)}
/>
