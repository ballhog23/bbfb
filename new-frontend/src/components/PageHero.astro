---
import { fade } from "@lib/fade";

type Props = {
    /** The small word or words on the first line. */
    small: string;
    /** The big blue word on the second line. */
    blue: string;
    /** home: centered, with its own sizes. page: left, with the shared sizes. */
    variant?: "home" | "page";
};

const { small, blue, variant = "page" } = Astro.props;
---

<header class:list={["hero", "container", variant]}>
    <h1>
        <span class="line" {...fade({ stagger: 0 })}>
            <span class="small">{small}</span>
        </span>
        <span class="line" {...fade({ stagger: 1 })}>
            <span class="blue">{blue}</span>
        </span>
    </h1>
    {Astro.slots.has("default") && (
        <div {...fade({ stagger: 2 })}>
            <p class="description">
                <slot />
            </p>
        </div>
    )}
</header>

<style>
    .hero {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: var(--screen);
        padding-block: 4rem;
    }

    h1 {
        display: flex;
        flex-direction: column;
        gap: 1.2vw;
        font-weight: 400;
        line-height: 0.88;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        animation: impact-shake 0.45s ease-out 1s both;
    }

    .line,
    .small,
    .blue {
        display: block;
    }

    .blue {
        font-weight: 900;
        background: linear-gradient(
            to right,
            var(--blue-500),
            var(--cyan-400),
            var(--blue-500)
        );
        background-size: 200% auto;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation:
            blue-slam 0.7s cubic-bezier(0.5, 0, 0.75, 0) 0.3s both,
            blue-glow 1.6s ease-out 1s both,
            gradient-shift 8s ease 1s infinite;
    }

    .page {
        align-items: flex-start;

        .small {
            font-size: var(--fs-section-title);
        }

        .blue {
            font-size: var(--fs-hero-word);
        }
    }

    /* "Bleed Blue" keeps its own sizes. */
    .home {
        align-items: center;
        overflow: hidden;
        text-align: center;

        h1 {
            align-items: center;
        }

        .small {
            font-size: min(12vw, 10.8rem);
        }

        .blue {
            font-size: min(23vw, 20.7rem);
        }
    }

    .description {
        max-width: 60ch;
        margin-top: 2rem;
        font-size: var(--fs-lead);
        line-height: 1.5;
        color: var(--text-muted);
        animation: settle 0.5s cubic-bezier(0.16, 1, 0.3, 1) 1.2s both;
    }

    @media (prefers-reduced-motion: reduce) {
        h1,
        .blue,
        .description {
            animation: none;
        }
    }

    @keyframes gradient-shift {
        0%,
        100% {
            background-position: 0% center;
        }
        50% {
            background-position: 100% center;
        }
    }

    @keyframes blue-slam {
        0% {
            opacity: 0;
            transform: scale(3.2);
            filter: blur(20px);
        }
        60% {
            opacity: 1;
        }
        100% {
            opacity: 1;
            transform: scale(1);
            filter: blur(0);
        }
    }

    @keyframes blue-glow {
        0% {
            filter: drop-shadow(0 0 70px rgb(0 194 255 / 0.95));
        }
        100% {
            filter: drop-shadow(0 0 0 rgb(0 194 255 / 0));
        }
    }

    @keyframes impact-shake {
        0%,
        100% {
            transform: translate(0, 0);
        }
        15% {
            transform: translate(-1.2vw, 0.6vw);
        }
        30% {
            transform: translate(1vw, -0.5vw);
        }
        45% {
            transform: translate(-0.7vw, 0.3vw);
        }
        60% {
            transform: translate(0.4vw, -0.2vw);
        }
        80% {
            transform: translate(-0.15vw, 0.1vw);
        }
    }

    @keyframes settle {
        from {
            opacity: 0;
            transform: translateY(-1rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
